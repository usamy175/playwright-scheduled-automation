# Local demo target
APP_HOST=127.0.0.1
APP_PORT=8000
APP_BASE_URL=http://127.0.0.1:8000

# Demo credentials only. Do not use real credentials in public projects.
APP_USERNAME=demo_user
APP_PASSWORD=demo_password

# Use 7200 for two hours in a real scheduled demo.
RUN_INTERVAL_SECONDS=10

# Browser settings
HEADLESS=true

# Optional: set to msedge or chrome if Playwright browsers are not installed.
BROWSER_CHANNEL=
